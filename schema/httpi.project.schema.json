{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string"
    },
    "env": {
      "type": "object",
      "properties": {
        "default": {
          "type": "string",
          "minLength": 1
        },
        "environments": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          }
        }
      },
      "required": [
        "environments"
      ],
      "additionalProperties": false
    },
    "run": {
      "minItems": 1,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "file"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "report": {
      "type": "object",
      "properties": {
        "junit": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "run"
  ],
  "additionalProperties": false
}
