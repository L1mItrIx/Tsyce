{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string"
    },
    "env": {
      "type": "object",
      "properties": {
        "default": {
          "type": "string",
          "minLength": 1
        },
        "environments": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          }
        }
      },
      "required": [
        "environments"
      ],
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][\\w-]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "oauth2"
              },
              "tokenUrl": {
                "type": "string",
                "minLength": 1
              },
              "clientId": {
                "type": "string",
                "minLength": 1
              },
              "scopes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "clientAuth": {
                "type": "string",
                "enum": [
                  "basic",
                  "body"
                ]
              },
              "flow": {
                "type": "string",
                "const": "client_credentials"
              },
              "clientSecret": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "type",
              "tokenUrl",
              "clientId",
              "flow",
              "clientSecret"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "oauth2"
              },
              "tokenUrl": {
                "type": "string",
                "minLength": 1
              },
              "clientId": {
                "type": "string",
                "minLength": 1
              },
              "scopes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "clientAuth": {
                "type": "string",
                "enum": [
                  "basic",
                  "body"
                ]
              },
              "flow": {
                "type": "string",
                "const": "refresh_token"
              },
              "refreshToken": {
                "type": "string",
                "minLength": 1
              },
              "clientSecret": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "type",
              "tokenUrl",
              "clientId",
              "flow",
              "refreshToken"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "oauth2"
              },
              "tokenUrl": {
                "type": "string",
                "minLength": 1
              },
              "clientId": {
                "type": "string",
                "minLength": 1
              },
              "scopes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "clientAuth": {
                "type": "string",
                "enum": [
                  "basic",
                  "body"
                ]
              },
              "flow": {
                "type": "string",
                "const": "authorization_code"
              },
              "authorizationUrl": {
                "type": "string",
                "minLength": 1
              },
              "clientSecret": {
                "type": "string",
                "minLength": 1
              },
              "redirectPort": {
                "default": 8787,
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "required": [
              "type",
              "tokenUrl",
              "clientId",
              "flow",
              "authorizationUrl"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "run": {
      "minItems": 1,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "data": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "file"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "report": {
      "type": "object",
      "properties": {
        "junit": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "run"
  ],
  "additionalProperties": false
}
