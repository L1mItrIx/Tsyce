{
  "info": {
    "_postman_id": "0f0f0f0f-0000-4000-8000-000000000001",
    "name": "Shop API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
  "variable": [
    { "key": "baseUrl", "value": "https://api.shop.example" },
    { "key": "unused", "value": "x", "disabled": true }
  ],
  "event": [{ "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["pm.variables.set('ts', Date.now());"] } }],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }, "auth": { "type": "noauth" } }
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List users",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('ok', () => pm.response.to.have.status(200));"] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "X-Debug", "value": "1", "disabled": true }],
            "url": { "raw": "{{baseUrl}}/users?page=1&limit=20", "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }] }
          }
        },
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{userName}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/users" }
          }
        },
        {
          "name": "Admin",
          "auth": { "type": "basic", "basic": [{ "key": "username", "value": "admin" }, { "key": "password", "value": "FAKE_PASSWORD" }] },
          "item": [
            {
              "name": "Delete user",
              "request": {
                "method": "DELETE",
                "header": [],
                "url": { "raw": "{{baseUrl}}/users/:id?force=true", "variable": [{ "key": "id", "value": "" }] }
              }
            },
            {
              "name": "Get user",
              "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/users/:id", "variable": [{ "key": "id", "value": "7" }] } }
            }
          ]
        }
      ]
    },
    {
      "name": "Orders & Payments",
      "auth": {
        "type": "oauth2",
        "oauth2": [
          { "key": "grant_type", "value": "client_credentials" },
          { "key": "accessTokenUrl", "value": "{{baseUrl}}/oauth/token" },
          { "key": "clientId", "value": "shop-ci" },
          { "key": "clientSecret", "value": "FAKE_CLIENT_SECRET" },
          { "key": "scope", "value": "orders.read orders.write" },
          { "key": "accessToken", "value": "FAKE_STALE_ACCESS_TOKEN" }
        ]
      },
      "item": [
        {
          "name": "Search orders",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": { "mode": "urlencoded", "urlencoded": [{ "key": "q", "value": "status=open & paid" }, { "key": "customer", "value": "{{customerId}}" }, { "key": "skip", "value": "1", "disabled": true }] },
            "url": "{{baseUrl}}/orders/search"
          }
        },
        {
          "name": "Upload receipt",
          "request": {
            "method": "POST",
            "body": { "mode": "formdata", "formdata": [{ "key": "note", "value": "paid", "type": "text" }, { "key": "receipt", "type": "file", "src": "receipts/r1.pdf" }, { "key": "photo", "type": "file", "src": [] }] },
            "url": { "raw": "{{baseUrl}}/orders/1/receipt" }
          }
        },
        {
          "name": "Order graph",
          "request": { "method": "POST", "body": { "mode": "graphql", "graphql": { "query": "{ orders { id } }" } }, "url": { "raw": "{{baseUrl}}/graphql" } }
        },
        {
          "name": "Signed",
          "request": { "method": "GET", "auth": { "type": "awsv4", "awsv4": [{ "key": "accessKey", "value": "FAKE_ACCESS_KEY" }] }, "url": { "raw": "{{baseUrl}}/orders/signed" } }
        },
        {
          "name": "With API key",
          "request": { "method": "GET", "auth": { "type": "apikey", "apikey": [{ "key": "key", "value": "X-Api-Key" }, { "key": "value", "value": "{{apiKey}}" }, { "key": "in", "value": "header" }] }, "url": { "raw": "{{baseUrl}}/orders" } }
        }
      ]
    },
    { "name": "Empty folder", "item": [] }
  ]
}
