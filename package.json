{
  "name": "httpi",
  "version": "0.0.0",
  "private": true,
  "description": "Paste a curl or answer a few questions, and get an API test ready to run in CI.",
  "type": "module",
  "bin": {
    "httpi": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run build && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "ink": "^8.0.0",
    "json-p3": "^3.0.3",
    "react": "^19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
